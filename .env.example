# Copy to .env outside the public/ document root. Never commit credentials.
APP_ENV=demo
APP_URL=http://127.0.0.1:8080
# Demo defaults to storage/commerce.sqlite if DB_DSN is empty.
DB_DSN=
DB_USER=
DB_PASSWORD=
# Production example: mysql:host=localhost;dbname=YOUR_DB;charset=utf8mb4
# APP_ENV=production closes checkout until the production workflow is completed.

PAYFAST_ENABLED=0
PAYFAST_SANDBOX=1
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
BOBGO_API_KEY=
BOBGO_SANDBOX=1
BREVO_API_KEY=
EMAIL_FROM=
# Fincon/Pargo/Internet Express contracts are account-specific and remain pending.
# AI ranking is injectable; no live AI provider or secret is bundled.
